# copy this file to .env (or just set these as actual env vars / IDE run config)
# and fill in your own values before running the app

# --- MySQL (default) ---
DB_URL=jdbc:mysql://localhost:3306/resource_booking_db
DB_USERNAME=root
DB_PASSWORD=root
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_DIALECT=org.hibernate.dialect.MySQLDialect

# --- If you want Postgres instead, comment the above and use these ---
# DB_URL=jdbc:postgresql://localhost:5432/resource_booking_db
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DRIVER=org.postgresql.Driver
# DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# --- JWT ---
JWT_SECRET=change-this-to-a-long-random-string-before-deploying-anywhere-real
JWT_EXPIRATION_MS=86400000
